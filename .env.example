# --- Supabase (https://supabase.com/dashboard/project/_/settings/api-keys/new) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (sb_publishable_...) — safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only (NEVER expose to the browser)
SUPABASE_URL=https://your-project.supabase.co
# Secret key (sb_secret_...) — replaces the legacy service_role JWT.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile) ---
# Required for anonymous (guest) signups. Site key is exposed in the browser
# widget; secret key is used server-side to verify the token.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAxxxxxxxxxxxxxx
TURNSTILE_SECRET_KEY=0x4AAAAAAAxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
# Used by the "Continue with Google" button on /login. Create an OAuth 2.0
# Client ID (type: Web application) and authorize the Supabase callback URLs:
#   - http://127.0.0.1:54321/auth/v1/callback   (local)
#   - https://<project-ref>.supabase.co/auth/v1/callback   (hosted)
# Locally these are read by `supabase start` via the env(...) refs in
# supabase/config.toml -> [auth.external.google]. The Supabase CLI auto-loads
# supabase/.env, so either put them there or export them in your shell before
# `pnpm supabase:start`. For hosted (staging/prod) configure the provider in
# the Supabase dashboard (Auth -> Providers -> Google) instead — these env
# vars are local-only.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=

# --- Sentry (https://sentry.io/settings/) ---
# DSN is exposed in the browser bundle; it's not a secret.
# Leave blank in local dev to no-op the SDK.
NEXT_PUBLIC_SENTRY_DSN=
# Source map upload (CI/Vercel only). Get an org auth token at
# https://sentry.io/orgredirect/organizations/:orgslug/settings/auth-tokens/
SENTRY_ORG=
SENTRY_PROJECT=pickupvb-web
SENTRY_AUTH_TOKEN=

# --- Stripe (https://dashboard.stripe.com/apikeys) ---
# Required for paid events / Stripe Connect onboarding. Leave blank in local
# dev to disable the payments surface (paid event UI hides itself).
#
# Use sk_test_... + pk_test_... in development and sb_test_... webhook secret
# from `stripe listen --forward-to localhost:3000/api/webhooks/stripe`.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook endpoint signing secret (whsec_...). Required to accept webhooks.
STRIPE_WEBHOOK_SECRET=
# Optional: only needed if using OAuth Connect onboarding instead of Express
# account links (we use Express links — leave blank).
STRIPE_CONNECT_CLIENT_ID=

# Pro Host subscription price IDs (Stripe Billing). Create a recurring
# product in the dashboard with monthly ($10/mo) and yearly ($100/yr) prices
# and paste the price_... IDs here. Required for /profile/billing/pro.
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=

# --- Notifications ---
# Resend transactional email (https://resend.com/api-keys). Required for any
# outbound email beyond Supabase Auth. Leave blank in dev to log-only.
RESEND_API_KEY=
# Sender address used by the worker. Must be a verified domain in Resend.
RESEND_FROM=PickupVB <noreply@pickupvb.com>

# Secret used by Vercel Cron to call the notification worker. Generate with
# `openssl rand -hex 32`. The worker rejects calls without this header.
CRON_SECRET=

# --- Web Push (VAPID) ---
# Browser push notifications via the standard Web Push protocol. Generate
# a keypair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Re-keying invalidates every existing push subscription — don't rotate
# casually. When unset the adapter throws on first use and the
# notification worker treats push as best-effort (other channels still
# fire). See docs/integrations.md#web-push-vapid.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:ops@pickupvb.com

# Public site origin used by templates to build CTA URLs.
NEXT_PUBLIC_APP_URL=https://pickupvb.com

# --- Analytics (https://posthog.com/) ---
# Server-side product analytics adapter. When `POSTHOG_API_KEY` or
# `POSTHOG_DISTINCT_ID_SALT` is missing, the composition root falls back
# to a noop adapter (no network calls). Leave blank in local dev.
#
# `POSTHOG_API_KEY` — PostHog **project API key** (write-only). Get it
# from Project Settings → API. Safe to ship on the server; never expose
# to the browser.
POSTHOG_API_KEY=
# `POSTHOG_DISTINCT_ID_SALT` — secret used to sha256-hash Supabase user
# ids before they cross the network. Generate with `openssl rand -hex 32`.
# Rotating this re-anonymizes existing actors (intentional — see
# docs/audits/analytics.md P3 #10).
POSTHOG_DISTINCT_ID_SALT=
# Optional ingest host. Defaults to `https://us.i.posthog.com`. Set to
# `https://eu.i.posthog.com` for EU-hosted projects.
POSTHOG_HOST=
