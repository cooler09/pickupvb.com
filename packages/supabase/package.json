{
  "name": "@pickupvb/supabase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts",
    "./server": "./src/server.ts",
    "./admin": "./src/admin.ts",
    "./anon": "./src/anon.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "gen:types": "supabase gen types typescript --local > src/database.types.ts.tmp && mv src/database.types.ts.tmp src/database.types.ts",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0"
  },
  "devDependencies": {
    "@pickupvb/config": "workspace:*",
    "@types/node": "^25.8.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "next": ">=15.5.16"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
