{
  "name": "@pickupvb/supabase",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts",
    "./server": "./src/server.ts",
    "./admin": "./src/admin.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'lint: no rules yet' && exit 0",
    "test": "echo no-tests",
    "gen:types": "supabase gen types typescript --local > src/database.types.ts.tmp && mv src/database.types.ts.tmp src/database.types.ts",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.45.4"
  },
  "devDependencies": {
    "@types/node": "25",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "next": ">=15.5.16"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  }
}
